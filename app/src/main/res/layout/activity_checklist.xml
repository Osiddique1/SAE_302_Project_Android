<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FBF7F7"
    tools:context=".ChecklistActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_checklist"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Checklist"
        app:titleTextColor="@android:color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/section_network_cabinet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Armoire Réseau :"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginBottom="16dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:id="@+id/options_cleanliness"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/check_cleanliness_ok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OK"/>
                    <CheckBox android:id="@+id/check_cleanliness_revoir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A revoir"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Propreté et état général de l'armoire"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/options_cleanliness"
                    android:textColor="@android:color/black"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:id="@+id/options_cabling"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/check_cabling_ok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OK"/>
                    <CheckBox android:id="@+id/check_cabling_revoir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A revoir"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Câblage à l'intérieur bien rangé"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/options_cabling"
                    android:textColor="@android:color/black"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:id="@+id/options_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/check_power_ok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OK"/>
                    <CheckBox android:id="@+id/check_power_revoir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A revoir"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alimentation électrique sécurisée"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/options_power"
                    android:textColor="@android:color/black"/>
            </RelativeLayout>

            <TextView
                android:id="@+id/section_patching"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brassage :"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:id="@+id/options_panels"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/check_panels_ok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OK"/>
                    <CheckBox android:id="@+id/check_panels_revoir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A revoir"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Panneaux de brassage étiquetés"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/options_panels"
                    android:textColor="@android:color/black"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:id="@+id/options_cable_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/check_cable_type_ok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OK"/>
                    <CheckBox android:id="@+id/check_cable_type_revoir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A revoir"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conformité du type de câble"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/options_cable_type"
                    android:textColor="@android:color/black"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:id="@+id/options_docs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/check_docs_ok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OK"/>
                    <CheckBox android:id="@+id/check_docs_revoir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A revoir"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Documentation de brassage à jour."
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/options_docs"
                    android:textColor="@android:color/black"/>
            </RelativeLayout>

            <TextView
                android:id="@+id/section_energy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Énergie (Alimentation) :"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"/>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:id="@+id/options_grounding"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/check_grounding_ok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OK"/>
                    <CheckBox android:id="@+id/check_grounding_revoir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A revoir"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mise à la terre (masse) vérifiée"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/options_grounding"
                    android:textColor="@android:color/black"/>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:id="@+id/options_outlets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/check_outlets_ok" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OK"/>
                    <CheckBox android:id="@+id/check_outlets_revoir" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="A revoir"/>
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="État des prises électriques"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@id/options_outlets"
                    android:textColor="@android:color/black"/>
            </RelativeLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Commentaires :"
                android:layout_marginTop="20dp"
                android:textStyle="bold"
                android:textColor="@android:color/black"/>

            <EditText
                android:id="@+id/comment_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Écrivez votre commentaire..."
                android:inputType="textMultiLine"
                android:gravity="top"
                android:minLines="4"
                android:background="@android:drawable/edit_text"
                android:padding="8dp" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Enregistrer" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>